{
  "name": "ChatGPT: no more em-dashes",
  "description": "ChatGPT Life Saver — Convert all em-dashes (—) to normal hyphens (-) on https://chatgpt.com pages",
  "version": "1.0",
  "manifest_version": 3,
  "author": "Patrick Deglon",
  "homepage_url": "https://github.com/patdeg/no-more-em-dashes",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}